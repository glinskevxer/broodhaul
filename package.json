{
  "name": "broodhaul",
  "version": "0.1.0",
  "private": true,
  "description": "Pollination desk for a migratory beekeeping operation: colony grading, contract settlement, hauls and hive health",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "broodhaul": "bin/broodhaul.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@vitest/coverage-v8": "2.1.5",
    "eslint": "9.14.0",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "vitest": "2.1.5"
  }
}
